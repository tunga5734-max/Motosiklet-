# Google Maps Platform anahtarı (Routes API + Maps SDK for Android).
# Boş bırakılırsa rota için OSRM + tahmini trafik modeli kullanılır.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Kendi OSRM sunucunuz (Türkiye OSM verisiyle). Varsayılan: herkese açık demo sunucu.
# EXPO_PUBLIC_OSRM_URL=https://osrm.sizin-sunucunuz.com
# EXPO_PUBLIC_OVERPASS_URLS=https://overpass-api.de/api/interpreter
# EXPO_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
